---
import { cases, contacts } from '../data/site';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const list = cases.map((c, i) => ({ ...c, ...t.production.cases[i] }));
---
<section class="prod chapter on-orange reveal" data-ink="on-orange" data-circle="places" id="production" aria-labelledby="prod-title">
  <div class="wrap">
    <h2 id="prod-title" class="display h2 prod__title" data-r set:html={t.production.title} />

    <div class="prod__grid">
      <div class="prod__copy">
        <p class="prod__lead" data-r style="--i:1" set:html={t.production.lead} />
        <ul class="prod__caps" data-r style="--i:2">
          {t.production.caps.map((c) => <li>{c}</li>)}
        </ul>
        <div class="prod__actions" data-r style="--i:3">
          <a class="btn" href={`tel:${contacts.partnersPhone.replace(/\s/g, '')}`}>{t.production.discuss}</a>
          <a class="btn btn--ghost" href={`mailto:${contacts.email}?subject=${encodeURIComponent(t.production.subject)}`}>{contacts.email}</a>
        </div>
      </div>
      <figure class="prod__photo" data-r style="--i:2">
        <img src="/img/golden-room.webp" width="1200" height="674" alt={t.production.alt} loading="lazy" />
      </figure>
    </div>

    <div class="prod__cases">
      <h3 class="h3" data-r>{t.production.casesTitle}</h3>
      <ul>
        {list.map((c, i) => (
          <li class="case" data-r style={`--i:${i}`}>
            <p class="case__guests display">{c.guests}</p>
            <div>
              <p class="case__name">{c.name}</p>
              <p>{c.brief}</p>
            </div>
            <p class="case__where">{c.guests} {t.production.guests}<br />{t.production.city}, {c.year}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .prod__title { margin-bottom: clamp(48px, 6vw, 96px); }
  .prod__grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 0 var(--gap); align-items: start; }
  .prod__copy { grid-column: 1 / 7; display: grid; gap: 40px; padding-right: 24px; }
  .prod__lead { font-size: clamp(19px, 1.65vw, 24px); line-height: 1.38; max-width: 36ch; }
  .prod__caps { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 32px; }
  .prod__caps li { display: flex; gap: 12px; align-items: baseline; font-weight: 500; }
  .prod__caps li::before { content: ''; flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--black); translate: 0 -2px; }
  .prod__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .prod__photo { grid-column: 7 / 13; margin: 0; border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; }
  .prod__photo img { width: 100%; height: 100%; object-fit: cover; }

  .prod__cases { margin-top: clamp(80px, 9vw, 140px); }
  .prod__cases h3 { margin-bottom: 24px; }
  .prod__cases ul { display: grid; gap: 8px; }
  .case { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2fr); gap: 24px; align-items: center; padding: 24px clamp(20px, 2.4vw, 36px); background: #ff6c38; border-radius: 20px; transition: background-color .3s; }
  .case:hover { background: var(--cream); }
  .case__guests { font-size: clamp(44px, 5vw, 88px); }
  .case__name { font-weight: 500; font-size: var(--t-h3); line-height: 1.15; margin-bottom: 6px; }
  .case__where { text-align: right; font-weight: 500; }

  @media (max-width: 860px) {
    .prod__copy, .prod__photo { grid-column: 1 / -1; }
    .prod__photo { margin-top: 40px; aspect-ratio: 4 / 3; }
    .prod__caps { grid-template-columns: 1fr; }
    .prod__title { font-size: 7vw; }
    .case { grid-template-columns: 1fr; gap: 8px; }
    .case__where { text-align: left; }
  }
  @media (max-width: 520px) { .prod__title { font-size: 8.2vw; } }
</style>
