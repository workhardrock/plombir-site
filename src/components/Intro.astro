---
import { introVideo } from '../data/site';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
---
<section class="intro on-black reveal" data-ink="light" data-circle="music" id="about" aria-labelledby="intro-title">
  <div class="intro__board">
    <div class="tile tile--a" data-r>
      <h2 id="intro-title" class="display" set:html={t.intro.title} />
    </div>
    <div class="tile tile--b" data-r style="--i:1">
      <p aria-label={t.intro.since}><span class="tile__est">est.</span><span class="display">2015</span></p>
    </div>
    <figure class="tile tile--c" data-r style="--i:2">
      {introVideo
        ? <video poster={introVideo.poster} muted loop playsinline preload="none" aria-label={t.intro.video} data-square={introVideo.square} data-vertical={introVideo.vertical}></video>
        : <img src="/img/moon-girl.webp" width="720" height="1080" alt={t.intro.alt} loading="lazy" />}
      {introVideo && (
        <button class="sound" type="button" aria-pressed="false" aria-label={t.intro.soundOn} data-on={t.intro.soundOn} data-off={t.intro.soundOff}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="sound__spk" d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
            <path class="sound__x" d="M15.5 9.5l5 5m0-5l-5 5" />
            <path class="sound__wave" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
          </svg>
        </button>
      )}
    </figure>
  </div>
  <div class="intro__text">
    <dl class="intro__facts" data-r style="--i:3">
      {t.intro.facts.map((f) => <div><dt class="display">{f.n}</dt><dd set:html={f.text} /></div>)}
    </dl>
    {t.intro.text.map((p, i) => <p data-r style={`--i:${3 + i}`} set:html={p} />)}
  </div>
</section>

<style>
  .intro { padding: 8px; padding-bottom: clamp(64px, 7vw, 112px); }
  .intro__board { display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: minmax(220px, 27svh) minmax(200px, 25svh); gap: 8px; }
  .tile { border-radius: 20px; overflow: hidden; display: flex; align-items: flex-end; padding: clamp(20px, 2.4vw, 36px); margin: 0; }
  .tile--a { grid-column: 1 / 9; grid-row: 1; background: var(--graphite); }
  .tile--a h2 { font-size: clamp(44px, 6vw, 108px); color: var(--cream); }
  .tile--b { grid-column: 1 / 9; grid-row: 2; background: var(--cream); color: var(--black); }
  .tile--b p { display: flex; align-items: baseline; gap: 0.18em; font-size: clamp(56px, 7vw, 124px); line-height: .9; }
  .tile__est { font-size: .34em; font-weight: 600; letter-spacing: -0.01em; }
  .tile--c { grid-column: 9 / 13; grid-row: 1 / 3; padding: 0; background: var(--graphite); }
  .tile--c img, .tile--c video { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; transition: transform .8s var(--ease); }
  .tile--c:hover img, .tile--c:hover video { transform: scale(1.04); }
  .tile--c { position: relative; }
  .sound {
    position: absolute; right: 16px; bottom: 16px; width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center; background: rgb(18 20 19 / .7); color: var(--cream);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: background .25s, color .25s, transform .25s var(--ease);
  }
  .sound:hover { transform: scale(1.08); }
  .sound svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sound__spk { fill: currentColor; }
  .sound__wave { display: none; }
  .sound[aria-pressed='true'] { background: var(--orange); color: var(--black); }
  .sound[aria-pressed='true'] .sound__x { display: none; }
  .sound[aria-pressed='true'] .sound__wave { display: inline; }

  .intro__text { display: grid; grid-template-columns: repeat(12, 1fr); gap: 40px 8px; padding: clamp(40px, 4.5vw, 72px) var(--m) 0; }
  .intro__facts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0; }
  .intro__facts div { display: grid; gap: 10px; align-content: start; }
  .intro__facts dt { color: var(--orange); font-size: clamp(40px, 4.4vw, 76px); white-space: nowrap; }
  .intro__facts dd { margin: 0; font-size: var(--t-body); max-width: 24ch; }
  .intro__text p { grid-column: span 6; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.45; max-width: 46ch; }

  @media (max-width: 760px) {
    .intro { padding: 6px; padding-bottom: 64px; }
    .intro__board { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 6px; }
    .tile--a { grid-column: 1 / -1; grid-row: 1; min-height: 150px; }
    .tile--a h2 { font-size: 11.5vw; }
    .tile--b { grid-column: 1 / -1; grid-row: 3; padding: 18px 20px; }
    .tile--b p { font-size: 15vw; }
    .tile--c { grid-column: 1 / -1; grid-row: 2; aspect-ratio: 4 / 5; }
    .intro__text { display: block; padding: 36px 14px 0; }
    .intro__facts { grid-template-columns: 1fr; gap: 22px; margin-bottom: 36px; }
    .intro__facts div { grid-template-columns: 5.2em 1fr; align-items: baseline; gap: 14px; font-size: 28px; }
    .intro__facts dt { font-size: 1em; }
    .intro__text p { font-size: 17px; }
    .intro__text p + p { margin-top: 1em; }
  }
</style>

<script>
  // Видео грузится, только когда блок близко к экрану: на телефоне вертикальное, на компьютере квадратное.
  // Тем, кто отключил анимацию в системе, остаётся заставка.
  const video = document.querySelector<HTMLVideoElement>('.tile--c video');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver((entries, io) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      video.src = matchMedia('(max-width: 760px)').matches ? video.dataset.vertical! : video.dataset.square!;
      video.play().catch(() => {});
    }, { rootMargin: '300px' }).observe(video);
  }

  // Кнопка звука: видео начинается без звука, по нажатию включается музыка шоурила.
  // Когда блок уходит с экрана, звук выключается сам.
  const sound = document.querySelector<HTMLButtonElement>('.tile--c .sound');
  if (video && sound) {
    const setSound = (on: boolean) => {
      video.muted = !on;
      sound.setAttribute('aria-pressed', String(on));
      sound.setAttribute('aria-label', (on ? sound.dataset.off : sound.dataset.on) || '');
    };
    sound.addEventListener('click', () => {
      if (!video.src) video.src = matchMedia('(max-width: 760px)').matches ? video.dataset.vertical! : video.dataset.square!;
      const on = video.muted;
      setSound(on);
      if (on) { video.currentTime = 0; video.play().catch(() => setSound(false)); }
    });
    new IntersectionObserver((entries) => { if (!entries[0].isIntersecting && !video.muted) setSound(false); }, { threshold: 0.1 }).observe(video);
  }
</script>
