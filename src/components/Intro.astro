---
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
---
<section class="intro on-black reveal" data-ink="light" data-circle="music" id="about" aria-labelledby="intro-title">
  <div class="intro__board">
    <div class="tile tile--a" data-r>
      <h2 id="intro-title" class="display" set:html={t.intro.title} />
    </div>
    <div class="tile tile--b" data-r style="--i:1">
      <p class="display" aria-label={t.intro.since}>2015</p>
    </div>
    <figure class="tile tile--c" data-r style="--i:2">
      <img src="/img/moon-girl.webp" width="720" height="1080" alt={t.intro.alt} loading="lazy" />
    </figure>
  </div>
  <div class="intro__text">
    <dl class="intro__facts" data-r style="--i:3">
      {t.intro.facts.map((f) => <div><dt class="display">{f.n}</dt><dd set:html={f.text} /></div>)}
    </dl>
    {t.intro.text.map((p, i) => <p data-r style={`--i:${3 + i}`} set:html={p} />)}
  </div>
</section>

<style>
  .intro { padding: 8px; padding-bottom: var(--section-y); }
  .intro__board { display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: 38svh 38svh; gap: 8px; }
  .tile { border-radius: 20px; overflow: hidden; display: flex; align-items: flex-end; padding: clamp(20px, 2.4vw, 36px); }
  .tile--a { grid-column: 1 / 9; grid-row: 1 / 3; background: var(--graphite); }
  .tile--a h2 { font-size: clamp(56px, 8.6vw, 150px); color: var(--cream); }
  .tile--b { grid-column: 9 / 13; grid-row: 1; background: var(--cream); color: var(--black); }
  .tile--b p { font-size: clamp(56px, 8.6vw, 150px); }
  .tile--c { grid-column: 9 / 13; grid-row: 2; padding: 0; }
  .tile--c img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform .8s var(--ease); }
  .tile--c:hover img { transform: scale(1.05); }

  .intro__text { display: grid; grid-template-columns: repeat(12, 1fr); gap: 0 8px; padding: clamp(48px, 6vw, 96px) var(--m) 0; }
  .intro__facts { grid-column: 1 / 6; grid-row: 1 / 3; display: grid; gap: 28px; align-content: start; margin: 0; }
  .intro__facts div { display: grid; grid-template-columns: 5.4em 1fr; align-items: baseline; gap: 16px; font-size: clamp(28px, 2.9vw, 48px); }
  .intro__facts dt { white-space: nowrap; }
  .intro__facts dt { color: var(--orange); }
  .intro__facts dd { margin: 0; font-size: var(--t-body); max-width: 22ch; }
  .intro__text p { grid-column: 7 / 13; font-size: clamp(19px, 1.65vw, 24px); line-height: 1.38; max-width: 40ch; }
  .intro__text p + p { margin-top: 1.1em; }

  @media (max-width: 760px) {
    .intro { padding: 6px; padding-bottom: var(--section-y); }
    .intro__board { grid-template-columns: 1fr 1fr; grid-template-rows: 46svh auto; gap: 6px; }
    .tile--a { grid-column: 1 / 3; grid-row: 1; }
    .tile--a h2 { font-size: 13vw; }
    .tile--b { grid-column: 1; grid-row: 2; aspect-ratio: 1; padding: 16px; }
    .tile--b p { font-size: 11vw; }
    .tile--c { grid-column: 2; grid-row: 2; aspect-ratio: 1; }
    .intro__text { display: block; padding: 40px 14px 0; }
    .intro__text p { font-size: 18px; }
    .intro__facts { margin-bottom: 40px; gap: 20px; }
    .intro__facts div { font-size: 28px; grid-template-columns: 5.2em 1fr; }
  }
</style>
