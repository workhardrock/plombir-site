---
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
---
<dialog class="tix" data-tix aria-label={t.ticketPopup.label}>
  <div class="tix__box">
    <div class="tix__bar">
      <a class="tix__ext small" data-tix-ext href="#" target="_blank" rel="noopener">{t.ticketPopup.newTab} ↗</a>
      <button class="tix__x" type="button" data-tix-close aria-label={t.ticketPopup.close}>✕</button>
    </div>
    <iframe data-tix-frame title={t.ticketPopup.label} referrerpolicy="same-origin" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-downloads allow-popups-to-escape-sandbox" allow="clipboard-write; payment"></iframe>
  </div>
</dialog>

<script>
  // Ссылки с data-widget открывают виджет билетного сервиса в попапе; без скрипта ссылка ведёт на страницу события
  const dlg = document.querySelector<HTMLDialogElement>('[data-tix]');
  if (dlg) {
    const frame = dlg.querySelector<HTMLIFrameElement>('[data-tix-frame]')!;
    const ext = dlg.querySelector<HTMLAnchorElement>('[data-tix-ext]')!;
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-widget]');
      if (!a) return;
      e.preventDefault();
      if (frame.src !== a.dataset.widget) frame.src = a.dataset.widget!;
      ext.href = a.href;
      dlg.showModal();
      document.body.style.overflow = 'hidden';
    });
    dlg.querySelector('[data-tix-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { document.body.style.overflow = ''; });
  }
</script>

<style>
  .tix { width: min(960px, 100vw - 32px); height: min(860px, 100svh - 32px); max-width: none; max-height: none; padding: 0; border: 1px solid var(--line, rgb(255 255 255 / .12)); border-radius: 16px; background: #121414; color: var(--cream); overflow: hidden; }
  .tix[open] { display: block; }
  .tix::backdrop { background: rgb(0 0 0 / .72); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .tix__box { display: grid; grid-template-rows: auto 1fr; height: 100%; }
  .tix__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 10px 10px 18px; border-bottom: 1px solid var(--line, rgb(255 255 255 / .12)); }
  .tix__ext { color: rgb(238 236 232 / .7); text-decoration: none; }
  .tix__ext:hover { color: var(--cream); }
  .tix__x { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line, rgb(255 255 255 / .2)); background: transparent; color: inherit; font-size: 16px; cursor: pointer; }
  .tix__x:hover, .tix__x:focus-visible { background: var(--cream); color: var(--black, #000); }
  .tix iframe { width: 100%; height: 100%; border: 0; background: #fff; }
  @media (max-width: 700px) {
    .tix { width: 100vw; height: 100svh; border-radius: 0; border: 0; }
  }
</style>
