---
// Первый экран в стиле «спектр»: синее свечение с оранжевым ядром, вертикальные линии,
// заголовок с засечками, цифры по бокам, светящаяся кнопка и стеклянные карточки снизу.
import { upcoming, releases } from '../data/site';
import Mark from './Mark.astro';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const f = t.hero.flux;
const next = { ...upcoming[0], ...t.upcoming[0] };
const second = { ...upcoming[1], ...t.upcoming[1] };
const rel = releases[0];
const units = ['d', 'h', 'm', 's'];
---
<section class="fx" data-ink="light" data-circle="places" aria-labelledby="hero-title">
  <div class="fx__sky" aria-hidden="true">
    <span class="fx__glow"></span>
    <span class="fx__lines"></span>
    <span class="fx__core"></span>
  </div>

  <div class="fx__top">
    <h1 id="hero-title" class="fx__title"><span class="sr-only">PLOMBIR — </span><span class="fx__in" style="--k:0" set:html={f.title[0]} /><br /><span class="fx__in" style="--k:1" set:html={f.title[1]} /></h1>
    <p class="fx__sub fx__in" style="--k:2" set:html={f.sub} />
  </div>

  <dl class="fx__stats fx__stats--l fx__in" style="--k:3">
    {f.statsL.map((s) => <div><dt>{s.n}</dt><dd set:html={s.text} /></div>)}
  </dl>
  <dl class="fx__stats fx__stats--r fx__in" style="--k:3">
    {f.statsR.map((s) => <div><dt>{s.n}</dt><dd set:html={s.text} /></div>)}
  </dl>

  <a class="fx__orb fx__in" style="--k:4" href={next.tickets} aria-label={`${t.hero.buy}: ${next.title}`}>
    <span class="fx__orb-ring" aria-hidden="true"></span>
    <Mark class="fx__orb-mark" />
    <span class="fx__orb-label">{f.orb}</span>
  </a>

  <div class="fx__cards">
    <article class="card fx__in" style="--k:5">
      <p class="card__tag">{f.cards[0]}</p>
      <div class="card__body card__next">
        <a href={next.tickets} class="card__thumb"><img src={next.poster} width="900" height="1200" alt={`${t.hero.poster}: ${next.title}`} /></a>
        <div>
          <h2 class="card__title">{next.title}</h2>
          <p class="card__meta">{next.day}, {next.date} · {next.venue}</p>
          <div class="card__count" data-countdown={next.start} aria-label={t.hero.countdown}>
            {units.map((u, i) => <div><b data-u={u}>—</b><span>{t.hero.units[i]}</span></div>)}
          </div>
        </div>
      </div>
    </article>
    <article class="card fx__in" style="--k:6">
      <p class="card__tag">{f.cards[1]}</p>
      <a class="card__body card__rel" href="#label">
        <img src={rel.cover} width="900" height="900" alt="" />
        <div>
          <p class="card__cat">{rel.cat}</p>
          <h2 class="card__title">{rel.track}</h2>
          <p class="card__meta">{rel.artist}</p>
          <span class="card__wave" aria-hidden="true">{Array.from({ length: 28 }, (_, i) => <i style={`--h:${(Math.sin(i * 1.7) * 0.5 + 0.5) * 0.8 + 0.2}`} />)}</span>
        </div>
      </a>
    </article>
    <article class="card fx__in" style="--k:7">
      <p class="card__tag">{f.cards[2]}</p>
      <div class="card__body card__next">
        <a href={second.tickets} class="card__thumb"><img src={second.poster} width="900" height="1200" alt={`${t.hero.poster}: ${second.title}`} /></a>
        <div>
          <h2 class="card__title">{second.title}</h2>
          <p class="card__meta">{second.day}, {second.date} · {second.venue}, {second.city}</p>
          <a class="card__btn" href={second.tickets}>{t.hero.buy}</a>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .fx {
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    position: relative; overflow: hidden; isolation: isolate;
    min-height: 100svh; padding: calc(72px + clamp(48px, 9svh, 110px)) var(--m) 0;
    display: grid; grid-template-columns: 1fr minmax(0, 760px) 1fr; grid-template-rows: auto 1fr auto; column-gap: 24px;
    background: #02070a; color: #eef3f6; font-variant-numeric: lining-nums;
  }

  /* --- Небо: свечение, спектральные линии, ядро --- */
  .fx__sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .fx__glow, .fx__lines, .fx__core { position: absolute; inset: 0; }
  .fx__glow {
    background:
      radial-gradient(60% 55% at 50% 78%, rgb(2 151 222 / .95), rgb(2 151 222 / .35) 45%, transparent 75%),
      radial-gradient(90% 70% at 50% 100%, rgb(10 70 160 / .8), transparent 70%),
      radial-gradient(40% 30% at 50% 0%, rgb(2 151 222 / .12), transparent 70%);
    transform-origin: 50% 85%; animation: fx-rise 2.2s cubic-bezier(.2, .7, .2, 1) both, fx-breathe 9s ease-in-out 2.2s infinite;
  }
  .fx__lines {
    background:
      repeating-linear-gradient(90deg, rgb(190 230 255 / .55) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(90deg, transparent 0 23px, rgb(2 7 10 / .55) 23px 31px);
    -webkit-mask: radial-gradient(52% 58% at 50% 76%, #000 10%, rgb(0 0 0 / .4) 45%, transparent 78%);
    mask: radial-gradient(52% 58% at 50% 76%, #000 10%, rgb(0 0 0 / .4) 45%, transparent 78%);
    mix-blend-mode: screen; opacity: .7; animation: fx-fade 2.6s ease .3s both;
  }
  .fx__core {
    background:
      radial-gradient(26% 22% at 50% 74%, rgb(255 196 160 / .9), rgb(252 115 77 / .9) 32%, rgb(252 115 77 / .25) 62%, transparent 80%),
      radial-gradient(60% 18% at 50% 92%, rgb(252 115 77 / .55), transparent 75%);
    mix-blend-mode: screen; animation: fx-fade 1.8s ease .9s both, fx-pulse 4.9s ease-in-out 2.7s infinite;
  }
  @keyframes fx-rise { from { transform: scaleY(.35); opacity: 0; } }
  @keyframes fx-breathe { 50% { transform: scaleY(1.05) scaleX(1.02); } }
  @keyframes fx-fade { from { opacity: 0; } }
  @keyframes fx-pulse { 50% { opacity: .82; } }

  /* --- Вступление: элементы проявляются по очереди --- */
  .fx__in { animation: fx-in 1.1s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(.35s + var(--k) * 110ms); }
  @keyframes fx-in { from { opacity: 0; transform: translateY(18px); filter: blur(10px); } }

  /* --- Заголовок --- */
  .fx__top { grid-column: 1 / -1; grid-row: 1; text-align: center; display: grid; justify-items: center; gap: 22px; }
  .fx__title { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(46px, 6.6vw, 112px); line-height: .98; letter-spacing: -0.01em; }
  .fx__title :global(em) { font-style: italic; font-weight: 500; }
  .fx__title .fx__in { display: inline-block; }
  .fx__sub { font-family: var(--mono); font-size: clamp(12px, .95vw, 14px); line-height: 1.6; color: rgb(220 235 245 / .75); max-width: 48ch; }

  /* --- Цифры по бокам --- */
  .fx__stats { grid-row: 2; align-self: start; margin-top: clamp(-120px, -9svh, -40px); display: grid; gap: 26px; font-family: var(--mono); }
  .fx__stats dt { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(26px, 2.2vw, 36px); line-height: 1; }
  .fx__stats dd { margin: 6px 0 0; font-size: 11px; letter-spacing: .04em; color: rgb(220 235 245 / .6); }
  .fx__stats--l { grid-column: 1; justify-self: start; }
  .fx__stats--r { grid-column: 3; justify-self: end; text-align: right; }

  /* --- Светящаяся кнопка --- */
  .fx__orb {
    grid-column: 2; grid-row: 2; align-self: center; justify-self: center; position: relative;
    width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; align-content: center; gap: 4px;
    background: radial-gradient(circle at 50% 40%, rgb(255 236 224 / .5), rgb(252 115 77 / .25) 55%, rgb(255 255 255 / .06));
    border: 1px solid rgb(255 255 255 / .45); color: #fff; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 0 40px rgb(252 115 77 / .45), inset 0 0 22px rgb(255 255 255 / .25);
    transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  }
  .fx__orb:hover { transform: scale(1.06); box-shadow: 0 0 70px rgb(252 115 77 / .7), inset 0 0 26px rgb(255 255 255 / .35); }
  .fx__orb-ring { position: absolute; inset: -14px; border-radius: 50%; border: 1px solid rgb(255 255 255 / .22); animation: fx-ring 3s ease-out infinite; }
  @keyframes fx-ring { from { transform: scale(.8); opacity: .9; } to { transform: scale(1.35); opacity: 0; } }
  .fx__orb :global(.fx__orb-mark) { width: 24px; color: #fff; }
  .fx__orb-label { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }

  /* --- Стеклянные карточки --- */
  .fx__cards { grid-column: 1 / -1; grid-row: 3; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 40px; transform: translateY(28px); }
  .card { display: grid; gap: 10px; }
  .card__tag { font-family: var(--mono); font-size: 11px; color: rgb(220 235 245 / .85); }
  .card__tag::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 8px; border-radius: 50%; background: #fc734d; vertical-align: 1px; }
  .card__body {
    display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: center; padding: 14px; border-radius: 18px 18px 0 0;
    background: linear-gradient(180deg, rgb(255 255 255 / .14), rgb(255 255 255 / .05));
    border: 1px solid rgb(255 255 255 / .18); border-bottom: 0; backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .25); color: inherit; min-height: 150px;
  }
  .card__thumb, .card__rel img { width: 84px; aspect-ratio: 3 / 4; border-radius: 10px; overflow: hidden; }
  .card__rel img { aspect-ratio: 1; width: 96px; object-fit: cover; }
  .card__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card__title { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 600; font-size: 24px; line-height: 1.05; }
  .card__meta { margin-top: 4px; font-family: var(--mono); font-size: 11px; color: rgb(220 235 245 / .65); }
  .card__cat { font-family: var(--mono); font-size: 10px; color: #fc734d; margin-bottom: 4px; }
  .card__count { display: flex; gap: 14px; margin-top: 10px; font-variant-numeric: tabular-nums; }
  .card__count div { display: grid; }
  .card__count b { font-family: var(--mono); font-weight: 500; font-size: 18px; }
  .card__count span { font-family: var(--mono); font-size: 9px; color: rgb(220 235 245 / .55); }
  .card__wave { display: flex; align-items: center; gap: 3px; height: 26px; margin-top: 10px; }
  .card__wave i { width: 3px; height: calc(var(--h) * 100%); border-radius: 2px; background: linear-gradient(180deg, #8fd3ff, #0297de); }
  .card__btn { display: inline-block; margin-top: 12px; padding: 8px 14px; border-radius: 999px; background: #eef3f6; color: #02070a; font-size: 12px; font-weight: 600; }

  @media (max-width: 960px) {
    .fx { grid-template-columns: 1fr 1fr; padding-top: calc(64px + 40px); column-gap: 16px; }
    .fx__top { grid-column: 1 / -1; }
    .fx__title { font-size: clamp(40px, 11vw, 64px); }
    .fx__orb { grid-column: 1 / -1; grid-row: 2; margin: 36px 0; width: 84px; height: 84px; }
    .fx__stats { grid-row: 3; margin-top: 0; gap: 18px; }
    .fx__stats--l { grid-column: 1; }
    .fx__stats--r { grid-column: 2; }
    .fx__cards { grid-row: 4; grid-template-columns: 1fr; margin-top: 32px; transform: none; }
    .fx__cards .card:nth-child(n + 2) { display: none; }
    .card__body { border-radius: 18px 18px 0 0; }
    .fx__glow { background: radial-gradient(90% 45% at 50% 52%, rgb(2 151 222 / .9), rgb(2 151 222 / .3) 50%, transparent 78%), radial-gradient(120% 60% at 50% 100%, rgb(10 70 160 / .7), transparent 70%); transform-origin: 50% 55%; }
    .fx__lines { -webkit-mask: radial-gradient(70% 40% at 50% 50%, #000 10%, transparent 80%); mask: radial-gradient(70% 40% at 50% 50%, #000 10%, transparent 80%); }
    .fx__core { background: radial-gradient(40% 14% at 50% 48%, rgb(255 214 190 / .9), rgb(252 115 77 / .7) 40%, transparent 80%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx__in, .fx__glow, .fx__lines, .fx__core, .fx__orb-ring { animation: none; }
  }
</style>
