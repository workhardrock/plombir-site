---
import { releases, music } from '../data/site';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const tones = ['graphite', 'orange', 'cream', 'graphite', 'orange'];
---
<section class="rel on-black reveal" data-ink="light" data-circle="music" id="label" aria-labelledby="rel-title">
  <div class="wrap section-head rel__head">
    <h2 id="rel-title" class="display h2" data-r>{t.releases.title}</h2>
    <a class="btn btn--ghost" href={music.beatport} data-r style="--i:1" set:html={t.releases.all} />
  </div>

  <ol class="rel__stack">
    {releases.map((r, i) => (
      <li class={`band band--${tones[i]}`} data-r style={`--i:${i}`}>
        <div class="band__strip">
          <span class="band__tab">{r.cat}</span>
          <span class="band__meta">{r.artist}</span>
        </div>
        <div class="band__body">
          <div class="band__cover">
            <img src={r.cover} width="900" height="900" alt={t.releases.cover(r.artist, r.track)} loading="lazy" />
            {r.preview && (
              <div class="player" data-player={r.preview} data-play={t.releases.play(r.track)} data-pause={t.releases.pause(r.track)}>
                <button class="player__btn" type="button" aria-label={t.releases.play(r.track)}>
                  <svg class="player__icon player__icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
                  <span class="player__icon player__icon--eq" aria-hidden="true"><i></i><i></i><i></i></span>
                </button>
                <span class="player__label">{t.releases.preview}</span>
                <span class="player__time" data-ui>0:00</span>
                <span class="player__bar" aria-hidden="true"><span></span></span>
              </div>
            )}
          </div>
          <div class="band__text">
            <h3 class="display band__track">{r.track}</h3>
            <p class="band__artist">{r.artist}</p>
            <div class="band__links">
              <a class="btn btn--sm" href={music.beatport}>Beatport</a>
              <a class="btn btn--ghost btn--sm" href={music.spotify}>Spotify</a>
              <a class="btn btn--ghost btn--sm" href={music.soundcloud}>SoundCloud</a>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>
  <a class="rel__more" href={music.beatport}>
    <span class="display">{t.releases.more}</span>
    <span>{t.releases.moreText}</span>
  </a>
</section>

<style>
  .rel { padding-top: var(--section-y); }
  .rel__head { margin-bottom: clamp(40px, 5vw, 84px); }
  /* Три релиза в один ряд */
  .rel__stack { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); padding: 0 var(--m) clamp(48px, 6vw, 96px); list-style: none; }
  .band { display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; }
  .band--graphite { background: var(--graphite); color: var(--cream); }
  .band--orange { background: var(--orange); color: var(--black); }
  .band--cream { background: var(--cream); color: var(--black); }
  .band__strip { height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 16px; }
  .band__tab {
    display: inline-flex; align-items: center; height: 40px; padding: 0 28px 0 18px;
    font-family: var(--display); font-weight: 700; font-size: 18px;
    background: var(--black); color: var(--cream);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 100%, 0 100%);
    border-radius: 10px 0 0 10px;
  }
  .band--graphite .band__tab { background: var(--orange); color: var(--black); }
  .band__meta { font-size: 16px; font-weight: 500; }
  .band__body { display: grid; gap: 20px; padding: 0 16px 20px; flex: 1; align-content: start; }
  .band__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .band__cover:has(.is-playing) img { transform: scale(1.03); }
  .player {
    position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; align-items: center; gap: 12px;
    padding: 8px 18px 8px 8px; border-radius: 999px; background: rgb(18 20 19 / .82); color: var(--cream);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); overflow: hidden;
  }
  .player__btn { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--orange); color: var(--black); transition: transform .25s var(--ease); }
  .player__btn:hover { transform: scale(1.08); }
  .player__icon { grid-area: 1 / 1; }
  .player__icon--play { width: 22px; height: 22px; fill: currentColor; }
  .player__icon--eq { display: none; gap: 3px; align-items: flex-end; height: 18px; }
  .player__icon--eq i { width: 4px; height: 100%; border-radius: 2px; background: currentColor; animation: eq .8s ease-in-out infinite alternate; transform-origin: bottom; }
  .player__icon--eq i:nth-child(2) { animation-delay: -.3s; }
  .player__icon--eq i:nth-child(3) { animation-delay: -.6s; }
  @keyframes eq { from { transform: scaleY(.25); } to { transform: scaleY(1); } }
  .is-playing .player__icon--play { display: none; }
  .is-playing .player__icon--eq { display: flex; }
  .player__label { font-weight: 600; font-size: 15px; }
  .player__time { margin-left: auto; font-size: 14px; font-variant-numeric: tabular-nums; color: var(--sand); }
  .player__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgb(230 223 213 / .15); }
  .player__bar span { display: block; height: 100%; width: 100%; background: var(--orange); transform: scaleX(var(--p, 0)); transform-origin: left; }
  .band__cover { position: relative; overflow: hidden; width: 100%; aspect-ratio: 1; border-radius: 12px; }
  .band__text { display: grid; gap: 8px; align-content: start; }
  .band__track { font-size: clamp(26px, 2.3vw, 40px); line-height: 1; }
  .band__artist { font-size: 16px; font-weight: 500; }
  .band__links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .band__links .btn--sm { min-height: 36px; padding: 0 14px; font-size: 13px; }
  .band .band__meta { display: none; }
  .band--graphite .band__links .btn:first-child { background: var(--orange); color: var(--black); }

  .rel__more {
    position: relative; z-index: 1; display: flex; align-items: baseline; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    padding: clamp(32px, 4vw, 56px) var(--m); background: var(--black); color: var(--cream); transition: color .25s;
  }
  .rel__more .display { font-size: clamp(36px, 5vw, 88px); color: var(--orange); transition: transform .35s var(--ease); }
  .rel__more:hover .display { transform: translateX(12px); }

  @media (max-width: 760px) {
    .rel__stack { grid-template-columns: 1fr; gap: 16px; padding-inline: 16px; }
    .band__track { font-size: 9vw; }
    .band__tab { font-size: 15px; }
  }
</style>

<script>
  // Отрывки релизов: один общий плеер, одновременно играет один трек
  const audio = new Audio();
  audio.preload = 'none';
  let current: HTMLElement | null = null;
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  const setState = (el: HTMLElement, playing: boolean) => {
    el.classList.toggle('is-playing', playing);
    el.querySelector('button')!.setAttribute('aria-label', (playing ? el.dataset.pause : el.dataset.play) || '');
  };
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((el) => {
    el.querySelector('button')!.addEventListener('click', () => {
      if (current === el && !audio.paused) { audio.pause(); return; }
      if (current !== el) {
        if (current) { setState(current, false); current.style.removeProperty('--p'); current.querySelector('.player__time')!.textContent = '0:00'; }
        current = el; audio.src = el.dataset.player!;
      }
      audio.play().catch(() => setState(el, false));
    });
  });
  audio.addEventListener('play', () => current && setState(current, true));
  audio.addEventListener('pause', () => current && setState(current, false));
  audio.addEventListener('ended', () => { if (current) { current.style.setProperty('--p', '0'); audio.currentTime = 0; } });
  audio.addEventListener('timeupdate', () => {
    if (!current || !Number.isFinite(audio.duration)) return;
    current.style.setProperty('--p', String(audio.currentTime / audio.duration));
    current.querySelector('.player__time')!.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
  });
</script>
