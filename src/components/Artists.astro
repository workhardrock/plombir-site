---
import { artists, contacts } from '../data/site';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const tints = ['var(--orange)', 'var(--sand)', '#ff8f63', '#a99f91'];
---
<section class="art chapter on-cream reveal" data-ink="dark" data-circle="people" id="artists" aria-labelledby="art-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="art-title" class="display h2" data-r>{t.artists.title}</h2>
      <a class="btn" href={`mailto:${contacts.email}?subject=${encodeURIComponent(t.artists.subject)}`} data-r style="--i:1">{t.artists.booking}</a>
    </div>
    <ul class="art__grid">
      {artists.map((a, i) => (
        <li class="artist" data-r style={`--i:${i % 4}; --tint:${tints[i % tints.length]}`}>
          <a class="artist__link" href={a.ig} target="_blank" rel="noopener" aria-label={t.artists.ig(a.name)}>
            <div class="artist__photo">
              <img src={a.photo} width="640" height="800" alt={a.name} loading="lazy" />
            </div>
            <h3 class="artist__name">{a.name} <span class="artist__ig" aria-hidden="true">↗</span></h3>
            <p class="artist__style">{t.artists.styles[i]}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .art__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px var(--gap); }
  .artist__photo { background: var(--tint); aspect-ratio: 4 / 5; overflow: hidden; border-radius: 20px; }
  .artist__photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.15); mix-blend-mode: multiply; transition: transform .7s var(--ease), filter .5s; }
  .artist__link { display: block; color: inherit; text-decoration: none; }
  .artist__ig { display: inline-block; font-size: .7em; vertical-align: .15em; transition: transform .3s var(--ease); }
  .artist__link:hover .artist__ig, .artist__link:focus-visible .artist__ig { transform: translate(2px, -2px); }
  .artist:hover .artist__photo img { transform: scale(1.04); filter: grayscale(0) contrast(1); mix-blend-mode: normal; }
  .artist__name { margin-top: 16px; font-family: var(--display); font-weight: 700; font-size: clamp(20px, 1.7vw, 28px); letter-spacing: -0.02em; text-transform: uppercase; }
  .artist__style { margin-top: 6px; font-size: 16px; max-width: 34ch; }

  @media (max-width: 760px) {
    .art__grid { grid-template-columns: 1fr 1fr; gap: 28px 8px; }
    .artist__photo { border-radius: 14px; }
    .artist__name { font-size: 17px; }
    .artist__style { font-size: 14px; }
  }
</style>
