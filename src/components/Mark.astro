---
// Знак PLOMBIR: три круга — music (верх), people (слева), places (справа).
interface Props { class?: string; title?: string }
const { class: cls = '', title } = Astro.props;
---
<svg class={`mark ${cls}`} viewBox="0 0 100 92" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <path d="M50 20 L20 72 L80 72 Z" fill="none" stroke="currentColor" stroke-width="9" stroke-linejoin="round" />
  <circle class="mark__c mark__c--music" cx="50" cy="20" r="19" />
  <circle class="mark__c mark__c--people" cx="20" cy="72" r="19" />
  <circle class="mark__c mark__c--places" cx="80" cy="72" r="19" />
</svg>

<style>
  .mark { display: block; overflow: visible; }
  .mark__c { fill: currentColor; transition: fill .3s, transform .4s var(--ease); transform-box: fill-box; transform-origin: center; }
</style>
