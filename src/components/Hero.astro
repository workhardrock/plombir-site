---
import { upcoming } from '../data/site';
import Mark from './Mark.astro';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const next = { ...upcoming[0], ...t.upcoming[0] };
const units = ['d', 'h', 'm', 's'];
---
<section class="hero" data-ink="on-orange" data-circle="places" aria-labelledby="hero-title">
  <div class="hero__photo" data-ink="light">
    <picture>
      <source media="(max-width: 700px)" srcset="/img/stage-v.webp" />
      <img src="/img/stage-h.webp" width="1200" height="900" alt={t.hero.alt} fetchpriority="high" />
    </picture>
  </div>
  <div class="hero__gl" data-gl aria-hidden="true"></div>

  <div class="hero__type">
    <h1 id="hero-title" class="hero__word display hero__word--top"><span class="sr-only">PLOMBIR{t.hero.h1Extra}</span><span class="hero__letters" aria-hidden="true">{'PLOMBIR'.split('').map((l, i) => <span style={`--k:${i}`}>{l}</span>)}</span></h1>
    <span class="hero__word display hero__word--bottom" aria-hidden="true">PLOMBIR</span>
  </div>

  <span class="palm hero__palm" aria-hidden="true"></span>
  <span class="palm hero__palm hero__palm--left" aria-hidden="true"></span>

  <div class="hero__lead">
    <p class="hero__tags">
      {t.hero.tags.map((w, i) => <>{i > 0 && <Mark class="hero__sep" />}<span>{w}</span></>)}
    </p>
    <p class="hero__sub" set:html={t.hero.lead} />
  </div>

  <div class="hero__next" data-ink="light">
    <a class="hero__poster" href={next.tickets} aria-label={`${t.hero.poster}: ${next.title}`}>
      <img src={next.poster} width="900" height="1200" alt={`${t.hero.poster}: ${next.title}`} />
    </a>
    <div class="hero__info">
      <h2 class="h3">{next.title}</h2>
      <p class="small">{next.day}, {next.date} · {next.venue}, {next.city}</p>
    </div>
    <div class="hero__count" data-ui data-countdown={next.start} aria-label={t.hero.countdown}>
      {units.map((u, i) => <div><b data-u={u}>—</b><span>{t.hero.units[i]}</span></div>)}
    </div>
    <a class="btn hero__buy" href={next.tickets}>{t.hero.buy}</a>
  </div>
</section>

<script>
  // 3D-сцена грузится после основной страницы; без WebGL остаётся фото зала
  const hero = document.querySelector<HTMLElement>('.hero');
  const host = hero?.querySelector<HTMLElement>('[data-gl]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasGL = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
  if (hero && host && hasGL) {
    const boot = () => import('../scripts/hero-scene').then(({ mountHeroScene }) => {
      mountHeroScene(host, hero, { still });
      requestAnimationFrame(() => hero.classList.add('is-gl'));
    }).catch(() => {});
    'requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 1200 }) : setTimeout(boot, 300);
  }
</script>

<style>
  .hero {
    --seam: 58svh;
    position: relative; background: var(--orange); color: var(--black);
    min-height: 100svh; padding-bottom: 0; overflow: hidden;
    display: grid; grid-template-rows: var(--seam) auto auto; grid-template-columns: minmax(0, 1fr);
  }
  .hero__photo { grid-row: 1; position: relative; overflow: hidden; background: var(--black); }
  .hero__photo picture { position: absolute; inset: 0; }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; animation: drift 18s var(--ease) both; }
  .hero__photo::after { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / .28); }
  @keyframes drift { from { transform: scale(1.12); } to { transform: scale(1); } }

  .hero__gl { grid-area: 1 / 1 / 4 / 2; position: absolute; inset: 0; z-index: 1; opacity: 0; transition: opacity 1.2s var(--ease); pointer-events: none; }
  .hero__gl :global(canvas) { display: block; width: 100%; height: 100%; }
  .hero__gl::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(2 7 10 / .55) 0%, transparent 18%, transparent 55%, rgb(2 7 10 / .7) 82%, var(--black) 100%); }
  .hero.is-gl .hero__gl { opacity: 1; }

  /* Слово PLOMBIR: буквы поднимаются по очереди, при прокрутке расходятся и гаснут */
  .hero__letters { display: inline-flex; letter-spacing: calc(var(--p, 0) * .18em); opacity: calc(1 - var(--p, 0) * 1.4); }
  .hero__letters span { display: inline-block; animation: rise 1.1s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(1.1s + var(--k) * 70ms); }
  @keyframes rise { from { transform: translateY(.5em); opacity: 0; filter: blur(12px); } }
  @media (prefers-reduced-motion: reduce) { .hero__letters span { animation: none; } }

  .hero__type { position: absolute; left: 0; right: 0; top: var(--seam); transform: translateY(-50%); height: 0.88em; font-size: var(--t-giant); pointer-events: none; z-index: 2; }
  .hero__word { position: absolute; inset: 0; display: block; text-align: center; font-size: 1em; white-space: nowrap; }
  .hero__word--top { color: var(--cream); clip-path: inset(0 0 50% 0); }
  .hero__word--bottom { color: var(--orange-deep); clip-path: inset(50% 0 0 0); }

  .hero__lead {
    grid-row: 2; position: relative; z-index: 1; margin: calc(var(--t-giant) * 0.62) auto 0; padding-inline: var(--m);
    display: grid; justify-items: center; gap: 14px; text-align: center;
  }
  .hero__tags {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.3em 0.55em;
    font-family: var(--display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1;
    font-size: clamp(22px, 2.6vw, 44px);
  }
  .hero__tags :global(.hero__sep) { width: 0.62em; color: var(--orange-deep); }
  .hero__sub { font-size: clamp(15px, 1.2vw, 18px); font-weight: 500; letter-spacing: 0.01em; }
  .hero__sub::before, .hero__sub::after { content: ''; display: inline-block; width: 28px; height: 1.5px; margin: 0 12px; vertical-align: middle; background: currentColor; }

  .hero__palm { right: -4vw; bottom: -6svh; width: min(56vw, 70svh); transform: scaleY(-1) rotate(-8deg); }
  .hero__palm--left { right: auto; left: -6vw; bottom: auto; top: calc(var(--seam) + 2svh); width: min(36vw, 48svh); transform: scaleX(-1) rotate(10deg); opacity: .7; }
  .hero__next { position: relative; z-index: 1; }

  .hero__next {
    grid-row: 3; display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: clamp(16px, 3vw, 48px);
    margin: clamp(40px, 6svh, 72px) var(--m) var(--m); padding: 16px; padding-right: 24px;
    background: var(--black); color: var(--cream); border-radius: 20px;
  }
  .hero__poster { width: 84px; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 10px; }
  .hero__poster img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .hero__poster:hover img { transform: scale(1.06); }
  .hero__info { display: grid; gap: 6px; }
  .hero__info .small { color: var(--sand); }
  .hero__count { display: flex; gap: clamp(14px, 2vw, 28px); font-variant-numeric: tabular-nums; }
  .hero__count div { display: grid; justify-items: center; }
  .hero__count b { font-family: var(--display); font-weight: 700; font-size: clamp(26px, 2.6vw, 42px); line-height: 1; color: var(--orange); }
  .hero__count span { font-size: 13px; color: var(--sand); margin-top: 6px; }
  .hero__buy { background: var(--orange); color: var(--black); }

  @media (max-width: 960px) {
    .hero { --seam: 46svh; }
    .hero__type { font-size: 15.4vw; }
    .hero__lead { margin-top: calc(15.4vw * 0.62); gap: 10px; }
    .hero__tags { font-size: 3.6vw; gap: 0.3em 0.4em; }
    .hero__sub { font-size: 14px; max-width: 30ch; }
    .hero__sub::before, .hero__sub::after { display: none; }
    .hero__palm { width: 78vw; right: -14vw; bottom: -2svh; }
    .hero__palm--left { width: 46vw; }
    .hero__next { grid-template-columns: auto 1fr; padding: 14px; gap: 14px 16px; border-radius: 16px; }
    .hero__poster { width: 64px; grid-row: span 1; }
    .hero__count { grid-column: 1 / -1; justify-content: space-between; }
    .hero__buy { grid-column: 1 / -1; }
  }
</style>
